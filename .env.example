# Contact form → Telegram bot and / or email (copy to .env.local and fill in; either channel is enough)
# Telegram: create a bot with @BotFather, write /start to it, then put your chat id here
TELEGRAM_BOT_TOKEN=
# your chat id, or a group id (starts with -100…); several ids, comma-separated
TELEGRAM_CHAT_ID=
# Email via Resend
RESEND_API_KEY=
CONTACT_TO=you@example.com
# optional, needs a verified domain in Resend
CONTACT_FROM=
# public site origin for canonical links, sitemap and robots (e.g. https://maxartdigital.com)
# Microsoft Clarity project id (clarity.microsoft.com → New project → Settings → Overview → Project ID); empty = no cookie banner, no Clarity
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_SITE_URL=
